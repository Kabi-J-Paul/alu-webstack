#!/usr/bin/env bash
# Display DNS information about the subdomains of a domain

audit_subdomain() {
	local name="$1"
	local domain="$2"
	local info
	info=$(dig "${name}.${domain}" | grep -A1 'ANSWER SECTION:' | awk 'NR==2 {print $4, $5}')
	read -r record_type destination <<< "$info"
	echo "The subdomain ${name} is a ${record_type} record and points to ${destination}"
}

if [ "$#" -eq 2 ]; then
	audit_subdomain "$2" "$1"
else
	for name in www lb-01 web-01 web-02; do
		audit_subdomain "$name" "$1"
	done
fi
